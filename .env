# Local config for docker-compose.yml (no secrets — safe to commit).
# The Makefile exports its own values, which take precedence over this file,
# so these are the defaults for bare `docker compose up -d`.

IMAGE=pi-token-usage:latest
NAME=pitokens

# Host paths mounted into the container (all read-only except DATA_DIR).
SESSIONS=${HOME}/.pi/agent/sessions
OPENCODE_DATA=${HOME}/.local/share/opencode
OCR_HOME=${HOME}/.opencodereview
DATA_DIR=${HOME}/.local/share/pi-token-usage

# Day bucketing. Must match the host zone or daily/monthly buckets shift by hours.
TZ=Europe/Helsinki

# Run as this host user so owner-only (0700) source dirs are readable.
RUNAS=1000:1000

# Listener: host:container. PORT_BIND=0.0.0.0 to expose beyond loopback.
PORT=7777
PORT_BIND=127.0.0.1
